# nginx in front of the site: /etc/nginx/sites-available/telegram-comments.
# Replace example.org with the site's name, enable the file, then let certbot
# add the certificate and the redirect from http:
#   ln -s /etc/nginx/sites-available/telegram-comments /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d example.org
server {
    listen 80;
    server_name example.org;

    location / {
        proxy_pass http://127.0.0.1:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The visitor's own address and nothing else. Not
        # $proxy_add_x_forwarded_for: it keeps what the visitor sent, and the
        # application would count wrong passwords by an address anyone can
        # invent.
        proxy_set_header X-Forwarded-For $remote_addr;
        # The political analysis of a large profile answers in minutes.
        proxy_read_timeout 600s;
    }
}
