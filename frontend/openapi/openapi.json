                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{tg_id}/search": {
      "get": {
        "summary": "Search User Comments",
        "description": "The user's comments closest in meaning to `q`.\n\n`context=false` ranks every comment by itself, without its chunk: the\nplain message search the default ranking is compared with.",
        "operationId": "search_user_comments",
        "parameters": [
          {
            "name": "tg_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Tg Id"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "context",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Context"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/position-analysis": {
      "post": {
        "summary": "Start Position Analysis",
        "operationId": "start_position_analysis",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisProgress"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisProgress": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "idle",
              "running",
              "done",
              "error",
              "interrupted",
              "provider_changed"
            ],
            "title": "State",
            "default": "idle"
          },
          "phase": {
            "type": "string",
            "title": "Phase",
            "default": ""
          },
          "processed_comments": {
            "type": "integer",
            "title": "Processed Comments",
            "default": 0
          },
          "total_comments": {
            "type": "integer",
            "title": "Total Comments",
            "default": 0
          },
          "cached_comments": {
            "type": "integer",
            "title": "Cached Comments",
            "default": 0
          },
          "rejected_comments": {
            "type": "integer",
            "title": "Rejected Comments",
            "default": 0
          },
          "rejection_reasons": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Rejection Reasons"
          },
          "processed_embeddings": {
            "type": "integer",
            "title": "Processed Embeddings",
            "default": 0
          },
          "total_embeddings": {
            "type": "integer",
            "title": "Total Embeddings",
            "default": 0
          },
          "cached_embeddings": {
            "type": "integer",
            "title": "Cached Embeddings",
            "default": 0
          },
          "processed_questions": {
            "type": "integer",
            "title": "Processed Questions",
            "default": 0
          },
          "total_questions": {
            "type": "integer",
            "title": "Total Questions",
            "default": 0
          },
          "extraction_requests": {
            "type": "integer",
            "title": "Extraction Requests",
            "default": 0
          },
          "split_batches": {
            "type": "integer",
            "title": "Split Batches",
            "default": 0
          },
          "activity": {
            "type": "string",
            "title": "Activity",
            "default": ""
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "processed_pairs": {
            "type": "integer",
            "title": "Processed Pairs",
            "default": 0
          },
          "total_pairs": {
            "type": "integer",
            "title": "Total Pairs",
            "default": 0
          },
          "processed_relations": {
            "type": "integer",
            "title": "Processed Relations",
            "default": 0
          },
          "total_relations": {
            "type": "integer",
            "title": "Total Relations",
            "default": 0
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "state",
          "phase",
          "processed_comments",
          "total_comments",
          "cached_comments",
          "rejected_comments",
          "rejection_reasons",
          "processed_embeddings",
          "total_embeddings",
          "cached_embeddings",
          "processed_questions",
          "total_questions",
          "extraction_requests",
          "split_batches",
          "activity",
          "updated_at",
          "processed_pairs",
          "total_pairs",
          "processed_relations",
          "total_relations",
          "error"
        ],
        "title": "AnalysisProgress"
      },
      "AxisCounts": {
        "properties": {
          "left_count": {
            "type": "integer",
            "title": "Left Count"
          },
          "right_count": {
            "type": "integer",
            "title": "Right Count"
          }
        },
        "type": "object",
        "required": [
          "left_count",
          "right_count"
        ],
        "title": "AxisCounts"
      },
      "ChannelShare": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "message_count": {
            "type": "integer",
            "title": "Message Count"
          },
          "percent": {
            "type": "number",
            "title": "Percent"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "dasharray": {
            "type": "string",
            "title": "Dasharray"
          },
          "dashoffset": {
            "type": "number",
            "title": "Dashoffset"
