      }
    },
    "/api/v1/users/{tg_id}/political-coords": {
      "post": {
        "summary": "Analyze Political",
        "operationId": "analyze_political",
        "parameters": [
          {
            "name": "tg_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Tg Id"
            }
