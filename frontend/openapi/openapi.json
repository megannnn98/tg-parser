          }
        },
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "JobStarted"
      },
      "JobStatus": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "user_ref": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "title": "User Ref"
          },
          "total_channels": {
            "type": "integer",
            "title": "Total Channels"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "resolved": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResolvedUser"
              },
              {
                "type": "null"
              }
            ]
          },
          "channels": {
            "items": {
              "$ref": "#/components/schemas/ChannelStatus"
            },
            "type": "array",
            "title": "Channels"
          },
          "saved_total": {
            "type": "integer",
            "title": "Saved Total"
          },
          "tg_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tg Id"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "user_ref",
          "total_channels",
          "state",
          "resolved",
          "channels",
          "saved_total",
          "tg_id",
          "error"
        ],
        "title": "JobStatus"
      },
      "PoliticalCoords": {
