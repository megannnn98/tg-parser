    "/api/v1/users/{tg_id}/position-comparisons": {
      "get": {
        "summary": "Get Position Comparisons",
        "operationId": "get_position_comparisons",
        "parameters": [
          {
            "name": "tg_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Tg Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
