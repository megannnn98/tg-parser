            "title": "Questions"
          }
        },
        "type": "object",
        "required": [
          "tg_id",
          "display_username",
          "score",
          "comparable_questions",
          "common_questions",
          "agreements",
          "partial",
          "disagreements",
          "eligible",
          "questions"
        ],
        "title": "Comparison"
      },
      "DayCount": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "date",
          "count"
        ],
        "title": "DayCount"
      },
      "EmbeddingDetails": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "dimensions": {
            "type": "integer",
            "title": "Dimensions"
          },
          "storage": {
            "type": "string",
            "title": "Storage"
          },
          "saved_vectors": {
            "type": "integer",
            "title": "Saved Vectors"
          }
        },
        "type": "object",
        "required": [
          "model",
          "version",
          "dimensions",
          "storage",
          "saved_vectors"
        ],
        "title": "EmbeddingDetails"
      },
      "Evidence": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "message_id": {
            "type": "integer",
            "title": "Message Id"
          },
          "position": {
            "type": "string",
            "title": "Position"
          },
          "question": {
            "type": "string",
            "title": "Question",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "text",
          "quote",
          "date",
          "channel",
          "message_id",
          "position",
          "question"
